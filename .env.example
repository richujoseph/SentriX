POSTGRES_USER=sentrix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentrix
DATABASE_URL=postgresql+psycopg2://sentrix:change-me@db:5432/sentrix
OLLAMA_URL=http://host.docker.internal:11434
# LLM used to summarise incidents: "ollama" (local, default) or "cloud"
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen3:8b
# Seconds to wait for a completion (local models can be slow)
LLM_TIMEOUT=120
# Only needed when LLM_BACKEND=cloud (Anthropic Messages API)
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-sonnet-5-5
# Suricata eve.json path inside the backend container (set in docker-compose.yml)
EVE_LOG_PATH=/logs/eve.json
# Default subnet for POST /assets/scan (can be overridden per request).
# Defaults to the lab network in docker-compose.yml.
SCAN_SUBNET=172.30.0.0/24

# Login for the lab SSH target (deliberately weak; internal network only)
TARGET_SSH_USER=labuser
TARGET_SSH_PASSWORD=labpass
# Correlation job: max gap between alerts of one incident, and how often it runs
CORRELATION_WINDOW_MINUTES=10
CORRELATION_INTERVAL_SECONDS=30
